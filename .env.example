# Base de datos local SQLite (archivo prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Clave usada para firmar la cookie de sesión. Cambiar en producción.
AUTH_SECRET="cambie-esta-clave-por-una-cadena-larga-y-aleatoria"

# Opcional: si se define, el ESP32 debe enviar el encabezado x-api-key.
# Dejar vacío para aceptar telemetría sin clave (solo red local de demostración).
IOT_API_KEY=""
