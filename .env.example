# Base de datos local SQLite (archivo prisma/dev.db)
# No cambie este valor para el uso en las laptops del colegio.
DATABASE_URL="file:./dev.db"

# Para Vercel se usa otra cadena y otro esquema (prisma/schema.postgres.prisma).
# Configure DATABASE_URL en el panel de Vercel, nunca en este archivo:
# postgresql://usuario:clave@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15

# Clave usada para firmar la cookie de sesión. Cambiar en producción.
AUTH_SECRET="cambie-esta-clave-por-una-cadena-larga-y-aleatoria"

# Opcional: si se define, el ESP32 debe enviar el encabezado x-api-key.
# Dejar vacío para aceptar telemetría sin clave (solo red local de demostración).
IOT_API_KEY=""
