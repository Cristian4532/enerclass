{
  "name": "enerclass",
  "version": "1.0.0",
  "private": true,
  "description": "EnerClass — Monitoreo inteligente del consumo eléctrico de la I.E. N° 2001 Leoncio Prado (Rímac, Lima)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "node scripts/build.mjs",
    "start": "next start -H 0.0.0.0 -p 3000",
    "postinstall": "node scripts/prisma-generate.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:push:postgres": "prisma db push --schema prisma/schema.postgres.prisma",
    "db:seed:postgres": "prisma db seed --schema prisma/schema.postgres.prisma",
    "db:generate:postgres": "prisma generate --schema prisma/schema.postgres.prisma",
    "setup": "prisma generate && prisma db push && prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "jspdf": "2.5.2",
    "jspdf-autotable": "3.8.4",
    "lucide-react": "^0.468.0",
    "next": "^14.2.0",
    "next-themes": "0.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.15.0",
    "sonner": "1.7.4",
    "tailwind-merge": "2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
